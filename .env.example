# Required only when using LLM-assisted code refinement.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings: fastembed (semantic local model), openai (API), or hashing (offline lexical fallback).
EMBEDDINGS_PROVIDER=fastembed

# Secure default. Docker unavailable => grading returns Unable to verify and executes nothing.
SPRINTS_SANDBOX=docker
SPRINTS_SANDBOX_IMAGE=python:3.12-slim
